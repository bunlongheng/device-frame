{
  "manifest_version": 3,
  "name": "Device Frame",
  "version": "1.1.0",
  "description": "Wrap the current tab in a realistic device bezel - iPhone, iPad, Pixel, Galaxy and more.",
  "action": {
    "default_title": "Frame this tab in a device",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting", "activeTab", "declarativeNetRequest", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["frames/*.png"], "matches": ["<all_urls>"] }
  ]
}
